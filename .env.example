# These are public browser configuration values, never service-role/API secrets.
# Obtain from the approved Supabase project. Leave blank for the existing demo.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Enable only after project/schema/RLS review and an explicitly approved migration.
VITE_DINING_DATABASE_ENABLED=false
# Optional replaceable style provider. Must be an HTTPS MapLibre style URL.
VITE_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/liberty
